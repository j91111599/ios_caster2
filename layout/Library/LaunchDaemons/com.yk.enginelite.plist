<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.yk.enginelite</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/ykenginelite</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>YK_HTTP_PORT</key>
		<string>65323</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>5</integer>
	<key>StandardOutPath</key>
	<string>/var/mobile/Media/ykd.log</string>
	<key>StandardErrorPath</key>
	<string>/var/mobile/Media/ykd.log</string>
</dict>
</plist>
